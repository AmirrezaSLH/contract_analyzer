# The build context. Everything the image does not need, so a rebuild does not
# ship secrets, the host virtualenv, or working material.

.git/
.gitignore
.github/

# Host virtualenv and caches -- wrong interpreter, wrong platform.
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets. Keys reach the container through env_file/-e at run time, never
# through a layer. .env.example is kept: it documents the knobs.
.env
.env.*
!.env.example

# Runtime state, mounted as volumes instead of baked in. Sample PDFs live on
# the host under data/samples and arrive through the compose bind mount.
data/
.run/

# Working material that has no business in a runtime image.
assignment_details/
plan_implement_docs/
docs/
presentation/
design/
ingest_smoke/
none_probe/
human/
AGENTS.md

# Host Node install; the image runs `npm ci` itself.
ui/node_modules/
ui/dist/
src/contract_analyzer/api/static/

# Accidental lockfile at the repo root; the UI's is ui/package-lock.json.
/package-lock.json

# Docker's own files (entrypoint.sh is not ignored: the runtime stage copies it).
Dockerfile
.dockerignore
docker-compose*.yml
