# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Generation -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5
ANSWER_MAX_TOKENS=8000
# output_config.effort: low | medium | high | xhigh | max. The cost lever.
ANSWER_EFFORT=low
# The chat prompt library, validated on load.
PROMPTS_PATH=src/contract_analyzer/generation/prompts.json

# --- Embeddings -------------------------------------------------------------
# openai (default) | local | fake
#   fake = hashed vectors: offline, deterministic, no semantics. For tests and
#          for demoing the pipeline with no API key -- never for real retrieval.
EMBEDDING_PROVIDER=openai
# Blank = the provider's default model (see DEFAULT_EMBEDDING_MODELS in config.py).
EMBEDDING_MODEL=
# The vec0 table's width is fixed when the table is created; changing this
# after ingesting means deleting the database and re-ingesting.
#   openai/text-embedding-3-small -> 1536, truncatable (512 is the default here)
#   local/bge-small-en-v1.5       -> 384 (fixed)
EMBEDDING_DIM=512
OPENAI_API_KEY=

# --- HTTP (every external call goes through http_client.py) -----------------
HTTP_TIMEOUT_SECONDS=60
# Attempts after the first: 3 means up to four requests, waiting 1s, 2s, 4s.
HTTP_RETRIES=3

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# One JSON object per line; what to tail during a demo. Blank disables the file.
LOG_FILE=.run/app.jsonl

# --- Storage & chunking -----------------------------------------------------
# Relative paths resolve against the project root, not the current directory.
DB_PATH=data/contracts.db
RAW_DIR=data/raw
ASSETS_DIR=data/assets
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=80

# --- Retrieval --------------------------------------------------------------
# hybrid (default) | vector | keyword
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=6
RRF_K=60
