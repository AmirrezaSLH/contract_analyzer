# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Reserved for secrets and paths that differ per environment (a local
# checkout vs. the Docker container vs. CI). Everything else -- model
# choice, effort levels, chunking, retrieval, HTTP, embeddings -- is a
# tuning parameter and lives in settings.json instead, versioned with the
# code. See docs/configuration.md.

# --- Ports ----------------------------------------------------------------
# One process serves both. The front end is a static bundle this API builds
# and mounts, so the browser only ever talks to one origin -- which is why
# `api_cors_origins` is empty and why BACKEND_PORT is the only port a demo
# needs. It is what ./start.bash, Docker and the healthcheck all use.
BACKEND_PORT=8100
# The Vite dev server, and only in development: `./start.bash --dev` and
# `make ui-dev`. It proxies /api to BACKEND_PORT, so the browser sees one
# origin there too. A plain `./start.bash` (no `--dev`) does not use it:
# the API already serves the built bundle on BACKEND_PORT.
FRONTEND_PORT=8101

# The MCP connector (MCP-Connector/), when it serves the HTTP transport --
# `./start.bash` and compose both do. A stdio connector is a client's own
# subprocess and binds nothing.
#
# The port is the only thing about that surface this file decides. Where the
# API is and which transport to serve are defaults in the connector's own
# config, overridden by a flag (start.bash) or by the service definition
# (compose) -- see MCP-Connector/ and docs/mcp.md.
MCP_PORT=8102

# --- Secrets ------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The key the HTTP API demands in `X-API-Key`. Blank means the API is open,
# which is the local demo; a deployment sets it. /health stays open either way.
API_KEY=

# --- Paths ----------------------------------------------------------------
# Relative paths resolve against the project root, not the current directory.
DB_PATH=data/contracts.db
RAW_DIR=data/raw
ASSETS_DIR=data/assets
# One JSON object per line; what to tail during a demo. Blank disables the file.
LOG_FILE=.run/app.jsonl
